# Bodywave Jira MCP Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# JIRA AUTHENTICATION (Required)
# =============================================================================

# Your Jira Cloud instance URL
JIRA_BASE_URL=https://your-domain.atlassian.net

# Your Atlassian account email
JIRA_USER_EMAIL=your-email@example.com

# API Token generated from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Request timeout in seconds
JIRA_TIMEOUT=30

# Rate limiting: max requests per minute (Jira Cloud default: 100)
JIRA_RATE_LIMIT=100

# =============================================================================
# OAUTH 2.0 (Future - Not implemented yet)
# =============================================================================

# JIRA_OAUTH_CLIENT_ID=
# JIRA_OAUTH_CLIENT_SECRET=
# JIRA_OAUTH_REDIRECT_URI=http://localhost:8080/callback
